# diy-manus runs fully local with ZERO of these set — they are optional overrides.
# Copy to .env to persist. Loaded by the CLI at startup only.

# LLM endpoint (OpenAI-compatible). Default is local ollama.
# For a hosted model instead, set e.g.:
#   MANUS_BASE_URL=https://api.openai.com/v1   MANUS_API_KEY=sk-...   MANUS_MODEL=gpt-4o-mini
#   MANUS_BASE_URL=https://api.z.ai/api/paas/v4 MANUS_API_KEY=...      MANUS_MODEL=glm-4.6
#MANUS_BASE_URL=http://127.0.0.1:11434/v1
#MANUS_API_KEY=ollama
#MANUS_MODEL=qwen2.5:3b

# Loop limits (local CPU machines are slow; these bounds keep runs predictable)
#MANUS_MAX_STEPS=30
#MANUS_STEP_MAX_TOKENS=512
#MANUS_SHELL_TIMEOUT_S=60
#MANUS_NET_TIMEOUT_S=30
#MANUS_OBSERVE_CAP_BYTES=10240

# Where the agent works and remembers
#MANUS_WORKSPACE=~/manus_workspace
#MANUS_DB=~/.local/share/diy-manus/sessions.db

# Web search: "ddgs" (keyless, default) or "searxng" (self-hosted)
#MANUS_SEARCH_BACKEND=ddgs
#MANUS_SEARXNG_URL=http://127.0.0.1:8080

# Thinking-model reasoning control: "none" (default), or empty to not send the field
#MANUS_REASONING_EFFORT=none
